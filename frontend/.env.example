# Roof detection now runs on our own backend ML model (no Roboflow / no exposed keys).
# Point this at the FastAPI backend. Local dev default is http://localhost:8000.
VITE_BACKEND_URL=http://localhost:8000

# Google Maps key for satellite tiles.
# NOTE: any VITE_-prefixed var is bundled into the shipped JS, so this key IS
# visible in the browser. Restrict it by HTTP referrer in the Google Cloud
# console (or proxy tiles server-side) before deploying publicly.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
